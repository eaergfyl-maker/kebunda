# FieldShift — Environment Configuration Template
# Core features (NASA POWER API, NASA GIBS WMTS tiles, and pre-harmonized benchmark farms) work without API keys.

# Backend Server
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional External API Keys (for extended live queries)
NASA_EARTHDATA_TOKEN=
USDA_NASS_API_KEY=
OPENET_API_KEY=

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
