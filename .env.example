# FieldShift — Environment Configuration Template
# Everything here is optional. Core features (NASA POWER, GPM IMERG, SRTM, MODIS, Sentinel-2 via the
# Planetary Computer, ISRIC SoilGrids, FAO GAEZ, NOAA GHCN-Daily gauges, NASA GIBS tiles and the
# pre-harmonized Malaysian benchmark farms) work without this file and without API keys.

# Backend Server
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Set to 1 to forbid all outbound requests (benchmark farms still work; custom fields need the cache)
FIELDSHIFT_OFFLINE=0
# Seconds before a live NASA or partner-service request gives up, and how long cached responses stay fresh
FIELDSHIFT_HTTP_TIMEOUT=45
FIELDSHIFT_CACHE_TTL_HOURS=720

# Optional External API Keys (each one only unlocks an extra live source)
NASA_EARTHDATA_TOKEN=

# Frontend Configuration
# Leave unset in development: the Vite dev server proxies /api to http://localhost:8000.
# Set it only when the frontend is served from a different origin than the API.
# VITE_API_BASE_URL=http://localhost:8000/api/v1
